<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trello_member_view_list" model="ir.ui.view">
        <field name="name">trello.member.list</field>
        <field name="model">trello.member</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="full_name" readonly="1"/>
                <field name="username" readonly="1"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_trello_member" model="ir.actions.act_window">
        <field name="name">Trello Members</field>
        <field name="res_model">trello.member</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
